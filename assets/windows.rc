1 ICON "assets/icon.ico"

1 VERSIONINFO
FILEVERSION APP_VERSION
PRODUCTVERSION APP_VERSION
FILEOS 0x00040004
FILETYPE 0x00000001
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "NotchCalendar"
            VALUE "FileVersion", APP_VERSION_STRING
            VALUE "OriginalFilename", "NotchCalendar.exe"
            VALUE "ProductName", "NotchCalendar"
            VALUE "ProductVersion", APP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
